<?xml version="1.0" encoding="utf-8"?>
<!--
  Sin este manifiesto, Windows no sabe que la app es "DPI aware" y termina
  aplicando DPI virtualization: agranda la ventana ya renderizada como si
  fuera una imagen (bitmap stretch) en vez de pedirle a WinForms que dibuje
  de nuevo a la escala correcta. Eso es lo que se ve como texto borroso y
  "cortado" en pantallas con escalado >100% (el caso mas comun hoy en
  laptops). AutoScaleMode.Dpi en el Designer ya asume que esto está
  declarado; sin el manifest, esa configuración no alcanza a evitar el
  problema.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="NetmanConfigTool.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 7 a 11: enumerarlos habilita el manejo moderno de DPI/tema. -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" /> <!-- Vista -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" /> <!-- 7 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" /> <!-- 8 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" /> <!-- 8.1 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" /> <!-- 10 / 11 -->
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- PM = per-monitor: la ventana se re-dibuja nítida en cada monitor,
           incluso si el usuario la arrastra entre pantallas con distinto
           escalado (por ejemplo, laptop 150% + monitor externo 100%). -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor, System</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
    </windowsSettings>
  </application>
</assembly>
